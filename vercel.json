{
  "functions": {
    "api/stripe-webhook.js": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/send-report.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/events/2026-11-19/?",
      "dest": "/event-recap-2026-11-19.html"
    },
    {
      "src": "/events/?",
      "dest": "/events.html"
    },
    {
      "src": "/community/?",
      "dest": "/community.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
